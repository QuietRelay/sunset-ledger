# Copy to .env for local overrides (not required for SQLite dev -- dev.py
# already has safe defaults for everything below). Required in production
# via config.settings.prod.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=

# Postgres (prod only)
DATABASE_URL=postgres://user:password@host:5432/sunset_ledger

# Object storage -- S3-compatible: Backblaze B2, Cloudflare R2, or AWS S3 (prod only)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT_URL=
STORAGE_REGION_NAME=

# Email -- any SMTP-speaking transactional provider (prod only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@example.org
